[Unit]
Description=Daily local Pi maintenance for amox lean extensions
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/amox_pi_extensions_lean
Environment=HOME=/home/ubuntu
Environment=TMPDIR=/home/ubuntu/.local/state/amox-pi-maintenance/tmp
Environment=AMOX_MAINTENANCE_STATE=/home/ubuntu/.local/state/amox-pi-maintenance
ExecStart=/usr/bin/node /home/ubuntu/projects/amox_pi_extensions_lean/scripts/local-maintenance.mjs --run
TimeoutStartSec=130min
Restart=no
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/.local/state/amox-pi-maintenance

[Install]
WantedBy=multi-user.target
