      "pi-goal-x/extensions/goal-context.ts": ["./tests/types/pi-goal-x.d.ts"],
      "pi-goal-x/extensions/goal-session-safety.ts": ["./tests/types/pi-goal-x.d.ts"]
    }
  },
  "include": [
    "index.ts",
    "tests/types/*.d.ts"
  ]
}
