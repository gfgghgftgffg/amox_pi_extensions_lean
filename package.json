{
  "name": "amox-pi-extensions-lean",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Three independently installable lean Pi extensions with reviewed automated upstream maintenance.",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.1.0",
    "@earendil-works/pi-coding-agent": ">=1.1.0",
    "@earendil-works/pi-tui": ">=1.1.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "jiti": "2.7.0",
    "typebox": "1.3.36",
    "typescript": "7.0.2"
  },
  "scripts": {
    "check": "npm run typecheck && npm test",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --test --test-concurrency=1 \"packages/*/tests/*.test.mjs\" \"tests/*.test.mjs\"",
    "contracts": "node scripts/capture-contracts.mjs --write",
    "contracts:check": "node scripts/capture-contracts.mjs --check",
    "verify:production": "node scripts/verify-production-install.mjs",
    "test:maintenance-pipeline": "node tests/integration/maintenance-pipeline.mjs",
    "maintenance:plan": "node scripts/check-upstream.mjs",
    "maintenance:stage": "node scripts/check-upstream.mjs --apply",
    "build": "npm run typecheck",
    "install:extension": "node scripts/install-extension.mjs",
    "maintenance:prepare": "node scripts/automate-maintenance.mjs prepare",
    "maintenance:adapt": "node scripts/automate-maintenance.mjs adapt",
    "maintenance:verify": "node scripts/automate-maintenance.mjs verify"
  },
  "files": [
    "packages/*/index.ts",
    "packages/*/package.json",
    "packages/*/tsconfig.json",
    "packages/*/LICENSE",
    "packages/*/README.md",
    "packages/*/README.zh-CN.md",
    "packages/*/MAINTENANCE.md",
    "docs/",
    "maintenance/",
    "scripts/",
    "LICENSE",
    "README.md"
  ]
}
